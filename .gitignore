#-------------------------------------------------
# Skills pipeline artefacts
#   (~/.claude/skills/WORKFLOW.md — review → issue → PR → merge)
#
# Scratch output from /issue-triage, /pr-triage, and /work-issue worktrees
# is covered globally by ~/.gitignore_global, not here.
#-------------------------------------------------
# Stage 1 review reports. Disposable by design: regenerate freely. Finding IDs
# (F1, F2, ...) are reconstructed from git history, so a deleted or never-
# committed report can't collide with IDs already cited in issues.
docs/reviews/

#-------------------------------------------------
# macOS housekeeping
#-------------------------------------------------
.DS_Store
*.swp

#-------------------------------------------------
# Xcode project & workspace artefacts
#-------------------------------------------------
# User–specific settings (window layout, breakpoints, scheme state, etc.)
**/xcuserdata/

# Intermediates created when a file collides or a merge aborts
*.moved-aside
*.xcodeproj/*-backup*

# Xcode build-time reports & diagnostics
*.xcresult

#-------------------------------------------------
# Derived output
#-------------------------------------------------
# Xcode’s build directory (default lives outside the repo, but this covers
# custom CONFIGURATION_BUILD_DIR settings or other edge cases)
Build/
DerivedData/
.derived-data-log-*

# Swift Package Manager artefacts
.build/

#-------------------------------------------------
# Miscellaneous
#-------------------------------------------------
# Symbolic crashes & profiling
*.dSYM.zip
*.dSYM
